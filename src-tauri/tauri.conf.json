{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AsciiDoc Studio",
  "version": "0.1.0",
  "identifier": "com.asciidoc.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AsciiDoc Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["adoc", "asciidoc"],
        "name": "AsciiDoc Document",
        "role": "Editor",
        "mimeType": "text/asciidoc",
        "rank": "Default",
        "exportedType": {
          "identifier": "com.asciidoc.studio.document",
          "conformsTo": ["public.plain-text"]
        }
      }
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
