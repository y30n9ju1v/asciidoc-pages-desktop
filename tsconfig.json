{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    /* ES2022.Error added on top of the ES2020 target purely for the
       Error(message, { cause }) constructor overload's type declarations
       (used by pdfPublicationRequest.ts) - every runtime this app ships to
       already supports it; this only affects type-checking, not emit
       (noEmit is on, Vite/esbuild handles actual transpilation). */
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* shadcn/ui's conventional import alias - mirrored in vite.config.ts's
       resolve.alias so it also works at build/dev time, not just for tsc. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "packages/asciidoc-typst/typescript/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
